---
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { SITE } from '@/consts';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image for social cards. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Set on post pages so crawlers get `article` instead of `website`. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt = `${SITE.title} logo`,
  imageWidth,
  imageHeight,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title ? `${title} | trbritt` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hasHeroImage = Boolean(image);
const socialImage = new URL(image ?? '/social-icon.png', Astro.site);
const socialImageWidth = imageWidth ?? 512;
const socialImageHeight = imageHeight ?? 512;
const twitterCard = hasHeroImage ? 'summary_large_image' : 'summary';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': ogType === 'article' ? 'BlogPosting' : 'WebSite',
  name: ogType === 'website' ? SITE.title : undefined,
  headline: ogType === 'article' ? title : undefined,
  description,
  url: canonical.href,
  image: socialImage.href,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.portfolio,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.portfolio,
  },
  datePublished: publishedTime?.toISOString(),
  dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="theme-color" content="#111111" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;700&display=swap"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    {ogType === 'article' && <meta property="article:author" content={SITE.author} />}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <slot name="head" />
  </head>

  <body class="min-h-screen">
    <div class="p-4">
      <!-- The bracketed frame from Portfolio.tsx, wrapping the whole page. -->
      <div
        class="corner-brackets relative flex min-h-[calc(100vh-2rem)] flex-col border border-terminal-line"
      >
        <div class="corner-bottom" aria-hidden="true"></div>

        <SiteHeader />

        <main class="flex-grow px-4 py-10 md:px-8 md:py-14">
          <slot />
        </main>

        <SiteFooter />
      </div>
    </div>
  </body>
</html>
