---
import type { CollectionEntry } from 'astro:content';
import TagList from '@/components/TagList.astro';
import { displayDate, isoDate, readingTime } from '@/consts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
const minutes = readingTime(post.body);
---

<article
  class="group relative border border-terminal-line transition-colors hover:border-terminal-edge"
>
  <a href={`/posts/${post.id}/`} class="block p-5 no-underline md:p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-xs">
      <time datetime={isoDate(pubDate)} class="text-terminal-dim">
        {displayDate(pubDate)}
      </time>
      <span class="text-terminal-dim">
        {draft && <span class="mr-3 text-terminal-accent">[DRAFT]</span>}
        {minutes} MIN
      </span>
    </div>

    <h2
      class="mt-3 text-lg leading-snug text-terminal-text transition-colors group-hover:text-terminal-accent"
    >
      <span class="mr-2 text-terminal-accentDim" aria-hidden="true">&gt;</span>{title}
    </h2>

    <p class="mt-3 max-w-[60ch] font-prose text-[0.95rem] leading-relaxed text-terminal-muted">
      {description}
    </p>
  </a>

  {tags.length > 0 && <TagList tags={tags} linked class="px-5 pb-5 md:px-6 md:pb-6" />}
</article>
