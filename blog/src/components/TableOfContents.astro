---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// Only h2/h3 — deeper nesting makes the rail noisy rather than useful.
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 1 && (
    <nav aria-labelledby="toc-heading" class="text-xs">
      <p
        id="toc-heading"
        class="mb-3 border-b border-terminal-line pb-2 uppercase tracking-[0.2em] text-terminal-dim"
      >
        Contents
      </p>
      <ul class="space-y-2">
        {headings.map((heading) => (
          <li class:list={[heading.depth === 3 && 'pl-4']}>
            <a
              href={`#${heading.slug}`}
              data-toc-link={heading.slug}
              class="block leading-relaxed text-terminal-muted no-underline transition-colors hover:text-terminal-accent"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Highlight whichever section is currently in view. Purely additive — the
  // links work without it.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const byId = new Map(
      [...links].map((link) => [link.dataset.tocLink!, link] as const)
    );
    const active = 'text-terminal-accent';

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => link.classList.remove(active));
          byId.get(entry.target.id)?.classList.add(active);
        }
      },
      // Trip when a heading enters the top third of the viewport.
      { rootMargin: '0px 0px -66% 0px', threshold: 0 }
    );

    for (const slug of byId.keys()) {
      const target = document.getElementById(slug);
      if (target) observer.observe(target);
    }
  }
</script>
